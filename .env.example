# ===== Domínio público (DNS deve apontar pra VPS) =====
DOMAIN=seudominio.com

# ===== Postgres =====
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=troque-essa-senha-agora
POSTGRES_DB=portfolio_auth

# ===== JWT =====
# Gerar com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== URLs públicas =====
# CORS liberado pro frontend
FRONTEND_URL=https://seudominio.com
# Embutido no build do frontend (Vite)
VITE_API_URL=https://seudominio.com/api/v1

# ===== Dev local / Claude Code MCP (NÃO usado em produção) =====
# O token da API Hostinger fica direto no .mcp.json (gitignored, chmod 600),
# como valor literal — NÃO use a forma "${HOSTINGER_API_TOKEN}" lá, porque o
# MCP recebe a string sem expandir e a API responde "Unauthenticated".
# O docker-compose não consome essa variável; deixe-a vazia aqui.
HOSTINGER_API_TOKEN=
